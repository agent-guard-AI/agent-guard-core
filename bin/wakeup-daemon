#!/usr/bin/env bash
#
# wakeup-daemon — launcher for the local HMVIP wakeup daemon.
#
# Usage:
#   source .hmvip-agent-init --wakeup-daemon   # future integration
#   bash packages/agent-guard-core/bin/wakeup-daemon
#
# Environment:
#   HMVIP_WAKEUP_SECRET   required shared HMAC secret
#   HMVIP_WAKEUP_PORT     optional port override
#   HMVIP_WAKEUP_HOST     optional host override
#   HMVIP_DISABLE_WAKEUP  set to 1 to noop
#   HMVIP_DISABLE_NOTIFY  set to 1 to skip desktop notifications

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
DAEMON_PY="${REPO_ROOT}/packages/agent-guard-core/src/wakeup-daemon.py"

if [[ ! -f "${DAEMON_PY}" ]]; then
    echo "[wakeup-daemon] ${DAEMON_PY} not found." >&2
    exit 1
fi

if [[ -z "${HMVIP_WAKEUP_SECRET:-}" ]]; then
    echo "[wakeup-daemon] HMVIP_WAKEUP_SECRET is not set." >&2
    echo "[wakeup-daemon] Set it before starting the daemon, e.g.:" >&2
    echo "  export HMVIP_WAKEUP_SECRET=\$(openssl rand -hex 32)" >&2
    exit 1
fi

# Resolve host/port for health check (env wins, then agent-guard.yaml, then defaults).
DEFAULT_HOST="127.0.0.1"
DEFAULT_PORT="17321"
HOST="${HMVIP_WAKEUP_HOST:-${DEFAULT_HOST}}"
PORT="${HMVIP_WAKEUP_PORT:-${DEFAULT_PORT}}"
if [[ -f "${REPO_ROOT}/agent-guard.yaml" ]] && command -v python3 >/dev/null 2>&1; then
    YAML_HOST="$(python3 -c '
import yaml, sys
try:
    cfg = yaml.safe_load(open(sys.argv[1]))
    print(cfg.get("wakeup", {}).get("host", ""))
except Exception:
    pass
' "${REPO_ROOT}/agent-guard.yaml" 2>/dev/null)"
    YAML_PORT="$(python3 -c '
import yaml, sys
try:
    cfg = yaml.safe_load(open(sys.argv[1]))
    print(cfg.get("wakeup", {}).get("port", ""))
except Exception:
    pass
' "${REPO_ROOT}/agent-guard.yaml" 2>/dev/null)"
    HOST="${HMVIP_WAKEUP_HOST:-${YAML_HOST:-${HOST}}}"
    PORT="${HMVIP_WAKEUP_PORT:-${YAML_PORT:-${PORT}}}"
fi

# Singleton guard: if a daemon is already healthy, do not start another.
if command -v curl >/dev/null 2>&1; then
    if curl -fsS --max-time 2 "http://${HOST}:${PORT}/health" >/dev/null 2>&1; then
        echo "[wakeup-daemon] already healthy on http://${HOST}:${PORT}; not starting." >&2
        exit 0
    fi
fi

exec python3 "${DAEMON_PY}" "$@"
