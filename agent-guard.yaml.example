---
# Agent Guard configuration example.
# Copy this file to the root of your repository as agent-guard.yaml and adjust
# the values to your project.

project:
  name: my-project
  domain: example.dev

paths:
  main_repo: /home/user/projects/my-project
  base_dir: /home/user/projects
  package_root: packages/agent-guard-core
  triage_script: .agent-guard/branch-triage.sh
  session_storage: .agent-guard/sessions
  init_script: .agent-guard-init

identities:
  kimi:
    slots: 4
    max_slots: 12
    auto_expand: true
    worktree_prefix: myproject-ia-kimi
    author_email: agent-kimi{n}@example.dev
    author_name: MyProject Kimi{n} Agent
  claude:
    slots: 2
    max_slots: 8
    auto_expand: true
    worktree_prefix: myproject-ia-claude
    author_email: agent-claude{n}@example.dev
    author_name: MyProject Claude{n} Agent
  gemini:
    slots: 2
    max_slots: 8
    auto_expand: true
    worktree_prefix: myproject-ia-gemini
    author_email: agent-gemini{n}@example.dev
    author_name: MyProject Gemini{n} Agent
  grok:
    slots: 2
    max_slots: 8
    auto_expand: true
    worktree_prefix: myproject-ia-grok
    author_email: agent-grok{n}@example.dev
    author_name: MyProject Grok{n} Agent
  amp:
    slots: 3
    max_slots: 10
    auto_expand: true
    worktree_prefix: myproject-ia-amp
    author_email: agent-amp{n}@example.dev
    author_name: MyProject Amp{n} Agent
  codewhale:
    slots: 2
    max_slots: 10
    auto_expand: true
    worktree_prefix: myproject-ia-codewhale
    author_email: agent-codewhale{n}@example.dev
    author_name: MyProject CodeWhale{n} Agent

git:
  protected_branches:
    - main
    - master
    - develop
    - staging
  notes_ref: refs/notes/agent-guard-worktree
  hooks_path: .githooks
  base_branch: develop

commit:
  author_template: agent-{identity}@{domain}
  message_pattern: '^(feat|fix|docs|refactor|chore|test|ci|hotfix)(\(.+\))?: .+'
  require_conventional: true
  identity_env_var: AGENT_GUARD_IDENTITY
  generic_agent_email_template: agent@{domain}

journal:
  path: .agent-guard/journal/agent-guard.jsonl
  retention_days: 90

session:
  stale_threshold_hours: 24
  auto_release_stale: true
  orphan_rescue:
    enabled: true
    ttl_days: 7
    workflow_auto: false
  blocked_event_notifications:
    enabled: true
    journal: true
    slot_note: true
  # Open PR cache: avoids a GitHub API round-trip on every release/stale check.
  # TTL in seconds (min 5). Cache is invalidated by git push via post-push hook.
  pr_cache_ttl_seconds: 60
  # Hard timeout for `gh pr list` so a slow API cannot stall release/shutdown.
  pr_api_timeout_seconds: 5

wrappers:
  kimi:
    bin_dir: /home/user/.kimi-code/bin
    real_bin: kimi.real
    default_role: ia-a
  amp:
    bin_dir: /home/user/.local/hmvip/bin
    real_bin_path: /home/user/.amp/bin/amp
    default_role: ia-a
    identity_prefix: amp
  codewhale:
    bin_dir: /home/user/.npm-global/bin
    real_bin: codewhale.real
    default_role: ia-a
    identity_prefix: codewhale
