#!/usr/bin/env bash
#
# POST-COMMIT HOOK — Agent Guard Core
# Adds worktree origin metadata to the current commit via git notes.
#
# Configuration is read from agent-guard.yaml (SSOT) via agent-guard-config.

set -euo pipefail

WORKTREE_PATH="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [[ -z "${WORKTREE_PATH}" ]]; then
    exit 0
fi

# Resolve the main repository root (where .agent-guard/tasks lives), even when
# running inside a linked git worktree.
git_common_dir="$(git -C "${WORKTREE_PATH}" rev-parse --git-common-dir 2>/dev/null || echo ".git")"
if [[ "${git_common_dir}" = /* ]]; then
    REPO_ROOT="$(cd "$(dirname "${git_common_dir}")" 2>/dev/null && pwd || echo "${WORKTREE_PATH}")"
else
    REPO_ROOT="$(cd "${WORKTREE_PATH}/${git_common_dir}/.." 2>/dev/null && pwd || echo "${WORKTREE_PATH}")"
fi

AGENT_GUARD_BIN="${REPO_ROOT}/packages/agent-guard-core/bin/agent-guard-config"

if [[ ! -f "${AGENT_GUARD_BIN}" ]]; then
    # Silently skip if agent-guard-core is not installed in this repo.
    exit 0
fi

NOTES_REF="$(bash "${AGENT_GUARD_BIN}" get git.notes_ref 'refs/notes/agent-guard-worktree')"

WORKTREE_NAME="$(basename "${WORKTREE_PATH}")"
IDENTITY=""

# Match worktree name against configured identity prefixes.
IDENTITY_NAMES="$(bash "${AGENT_GUARD_BIN}" keys identities)"
for name in ${IDENTITY_NAMES}; do
    prefix="$(bash "${AGENT_GUARD_BIN}" get "identities.${name}.worktree_prefix" '')"
    # Support optional task suffix (e.g. hmvip-ia-kimi4-bling).
    if [[ -n "${prefix}" && "${WORKTREE_NAME}" =~ ^${prefix}[0-9]+(-[a-z0-9-]+)?$ ]]; then
        slot_and_suffix="${WORKTREE_NAME#${prefix}}"
        # Strip any suffix from the slot number.
        IDENTITY="${name}${slot_and_suffix%%-*}"
        break
    fi
done

if [[ -z "${IDENTITY}" ]]; then
    # Not an AI worktree; do not add metadata.
    exit 0
fi

BRANCH="$(git branch --show-current 2>/dev/null || echo "")"

NOTE_CONTENT="worktree:${WORKTREE_PATH}
identity:${IDENTITY}
branch:${BRANCH}"

if ! git notes --ref="${NOTES_REF}" add -f -m "${NOTE_CONTENT}" HEAD >/dev/null 2>&1; then
    echo "⚠️  [AGENT GUARD] Failed to add worktree origin note to HEAD." >&2
    echo "   Run manually before pushing:" >&2
    echo "     git notes --ref=${NOTES_REF} add -m 'worktree:${WORKTREE_PATH}" >&2
    echo "identity:${IDENTITY}" >&2
    echo "branch:${BRANCH}' HEAD" >&2
fi

# Record commit event in session journal for crash recovery.
JOURNAL_SCRIPT="${REPO_ROOT}/packages/agent-guard-core/src/journal.sh"
if [[ -f "${JOURNAL_SCRIPT}" ]]; then
    source "${JOURNAL_SCRIPT}"
    COMMIT_SHA="$(git rev-parse HEAD 2>/dev/null || echo "")"
    COMMIT_MSG="$(git log -1 --pretty=%s 2>/dev/null || echo "")"
    export AGENT_GUARD_IDENTITY="${IDENTITY}"
    export AGENT_GUARD_BRANCH="${BRANCH}"
    export AGENT_GUARD_WORKTREE_PATH="${WORKTREE_PATH}"
    _journal_commit "${COMMIT_SHA}" "${COMMIT_MSG}"
fi

# Task lifecycle: primeiro commit em task branch move state planning -> coding.
TASK_LIFECYCLE_SCRIPT="${REPO_ROOT}/packages/agent-guard-core/src/task-lifecycle.sh"
if [[ -f "${TASK_LIFECYCLE_SCRIPT}" && -n "${IDENTITY}" ]]; then
    # shellcheck source=/dev/null
    source "${TASK_LIFECYCLE_SCRIPT}"
    NOTE_PATH="${REPO_ROOT}/.agent-guard/tasks/${IDENTITY}.md"
    if [[ -f "${NOTE_PATH}" ]]; then
        CURRENT_STATE="$(_task_get_field "${NOTE_PATH}" "state" 2>/dev/null || true)"
        if [[ "${CURRENT_STATE}" == "planning" ]]; then
            if _task_set_state "${NOTE_PATH}" "coding" "primeiro commit" "${IDENTITY}" "${REPO_ROOT}" 2>/dev/null; then
                if command -v _journal_task_state_changed >/dev/null 2>&1; then
                    _journal_task_state_changed "${IDENTITY}" "" "planning" "coding" "primeiro commit"
                fi
            fi
        fi
    fi
fi

# Capture a session-trace checkpoint for every commit so the conversation
# context is linked to the code state and searchable after a crash.
TRACE_SCRIPT="${REPO_ROOT}/packages/agent-guard-core/src/session_trace.sh"
if [[ -f "${TRACE_SCRIPT}" && -d "${WORKTREE_PATH}/.agent-guard/session" ]]; then
    source "${TRACE_SCRIPT}"
    export AGENT_GUARD_REPO_ROOT="${REPO_ROOT}"
    export AGENT_GUARD_WORKTREE_PATH="${WORKTREE_PATH}"
    export AGENT_GUARD_IDENTITY="${IDENTITY}"
    export AGENT_GUARD_BRANCH="${BRANCH}"
    _trace_checkpoint "commit ${COMMIT_SHA}" >/dev/null 2>&1 || true
fi
